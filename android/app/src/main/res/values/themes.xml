<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole screen; the window only shows before the first frame. -->
    <style name="Theme.Clipsync" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- A see-through window with no animation: it only takes focus long enough to read the clipboard. -->
    <style name="Theme.Clipsync.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
