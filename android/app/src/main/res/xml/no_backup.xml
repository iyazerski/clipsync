<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup or device transfer: the preferences hold the secret. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
